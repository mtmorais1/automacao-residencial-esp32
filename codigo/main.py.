from machine import Pin, ADC
import dht
import time

led = Pin(23, Pin.OUT)
botao = Pin(18, Pin.IN, Pin.PULL_UP)

ldr = ADC(Pin(34))
ldr.atten(ADC.ATTN_11DB)

dht22 = dht.DHT22(Pin(15))
pir = Pin(27, Pin.IN)

ultimo_movimento = time.ticks_ms()
tempo_luz = 10000  # 10 segundos

while True:
    luminosidade = ldr.read()
    movimento = pir.value()

    escuro = luminosidade > 1000

    if movimento == 1 and escuro:
        ultimo_movimento = time.ticks_ms()

    tempo_passado = time.ticks_diff(
        time.ticks_ms(), ultimo_movimento
    )

    presenca_recente = tempo_passado < tempo_luz

    if botao.value() == 0 or (presenca_recente and escuro):
        led.value(1)
    else:
        led.value(0)

    try:
        dht22.measure()
        print("Luminosidade:", luminosidade)
        print("Temperatura:", dht22.temperature(), "C")
        print("Umidade:", dht22.humidity(), "%")
    except OSError:
        print("Erro na leitura do DHT22")

    print("Ambiente escuro" if escuro else "Ambiente claro")
    print("Presenca detectada!" if movimento else "Sem movimento")
    print("--------------------")

    time.sleep(1)
